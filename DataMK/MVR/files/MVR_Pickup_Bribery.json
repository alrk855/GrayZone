{
  "lines": [
    {
      "speaker": "Шалтерски службеник",
      "text": "Се вративте. Во ред."
    },
    {
      "speaker": "Шалтерски службеник",
      "text": "Нема редови, нема печати — баш како што баравте."
    },
    {
      "speaker": "Шалтерски службеник",
      "text": "Нека остане ова меѓу нас."
    }
  ]
}