offset_right = 0.0219727
offset_bottom = 18.547
theme_override_font_sizes/font_size = 46
text = "The story moves forward one day at a time.

Sleeping at Home after 19:00 advances to the next day.

But stay up too late, and you’ll sleep in, losing part of the next morning."
vertical_alignment = 1
autowrap_mode = 3

