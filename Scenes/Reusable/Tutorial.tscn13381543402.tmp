theme_override_font_sizes/font_size = 46
text = "Every action (talking, studying, printing, traveling) advances the clock.


Some people are only available at certain hours — miss them, and you’ll have to wait for another chance."
vertical_alignment = 1
autowrap_mode = 3

[node name="Day" type="Label" parent="Page2/Padding/Border"]
